BOT_TOKEN=your_telegram_bot_token
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# Telegram API credentials from https://my.telegram.org
# Required for downloading media larger than the standard Bot API 20 MB limit.
# The bot connects with BOT_TOKEN; no personal phone session is used.
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash

# Leave these disabled when using the MTProto downloader.
TELEGRAM_API_BASE_URL=
TELEGRAM_LOCAL_MODE=false

# Persistent folder for sessions, downloads, and the Telethon bot session.
DATA_DIR=/data
