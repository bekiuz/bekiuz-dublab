BOT_TOKEN=your_telegram_bot_token
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# Telegram Local Bot API credentials from my.telegram.org
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash

# Local API is started by the Docker entrypoint
TELEGRAM_API_BASE_URL=http://127.0.0.1:8081
TELEGRAM_LOCAL_MODE=true

# Set true only on the first cloud deployment to move this bot to Local Bot API.
# A persistent /data volume stores the one-time migration marker.
TELEGRAM_AUTO_LOGOUT=true
DATA_DIR=/data
